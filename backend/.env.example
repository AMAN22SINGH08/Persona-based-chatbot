# OpenAI-Compatible API Configuration (Optional)
# If left blank, the application automatically operates in Academic Demo Mode
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./persona_chatbot.db

# Demo Mode Setting ('auto', 'true', or 'false')
DEMO_MODE=auto
